static func create(circuit_id: String) -> WmcCircuit:
	var selected: Dictionary = circuits.get(circuit_id, circuits["sepang"])
	return WmcCircuit.new(
		circuit_id if circuits.has(circuit_id) else "sepang",
		selected["name"],
		selected["hashtag"],
		selected["length"],
		selected["points"]
	)
